{% doc %}
  Renders a small uppercase label.

  @example
  {% content_for 'block', type: 'eyebrow', id: 'eyebrow' %}
{% enddoc %}

<p class="eyebrow eyebrow-block" style="--align: {{ block.settings.alignment }}" {{ block.shopify_attributes }}>
  {%- if block.settings.show_dot -%}<span class="eyebrow-block__dot" aria-hidden="true"></span>{%- endif -%}
  {{- block.settings.text -}}
</p>

{% stylesheet %}
  .eyebrow-block {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    justify-content: var(--align);
  }
  .eyebrow-block__dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--color-accent);
    animation: pulse 2.4s infinite;
  }
  @keyframes pulse {
    50% { opacity: 0.3; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Eyebrow",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Collection 01" },
    { "type": "checkbox", "id": "show_dot", "label": "Show pulse dot", "default": false },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "flex-start"
    }
  ],
  "presets": [{ "name": "Eyebrow" }]
}
{% endschema %}
