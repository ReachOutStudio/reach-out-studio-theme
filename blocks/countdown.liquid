{% doc %}
  Countdown to the drop date set in theme settings. Swaps to a live message when it ends.

  @example
  {% content_for 'block', type: 'countdown', id: 'countdown' %}
{% enddoc %}

<drop-countdown class="countdown countdown--{{ block.settings.size }}" data-end="{{ settings.drop_datetime | escape }}" {{ block.shopify_attributes }}>
  <div class="countdown__units" data-countdown-units>
    <div class="countdown__unit"><span data-unit="days">00</span><small class="eyebrow">{{ 'sections.countdown.days' | t }}</small></div>
    <div class="countdown__unit"><span data-unit="hours">00</span><small class="eyebrow">{{ 'sections.countdown.hours' | t }}</small></div>
    <div class="countdown__unit"><span data-unit="minutes">00</span><small class="eyebrow">{{ 'sections.countdown.minutes' | t }}</small></div>
    <div class="countdown__unit"><span data-unit="seconds">00</span><small class="eyebrow">{{ 'sections.countdown.seconds' | t }}</small></div>
  </div>
  <div class="countdown__live" data-countdown-live hidden>
    <p class="h-2">{{ block.settings.live_text }}</p>
    {%- if block.settings.live_link != blank -%}
      <a class="button" href="{{ block.settings.live_link }}">{{ block.settings.live_button }}</a>
    {%- endif -%}
  </div>
</drop-countdown>

{% stylesheet %}
  .countdown__units {
    display: flex;
    gap: clamp(1rem, 3vw, 2.5rem);
  }
  .countdown__unit {
    display: grid;
    gap: 0.35rem;
  }
  .countdown__unit span {
    font-family: var(--font-heading--family);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }
  .countdown--large .countdown__unit span {
    font-size: clamp(2.5rem, 6vw, 5rem);
  }
  .countdown--small .countdown__unit span {
    font-size: 1.75rem;
  }
  .countdown__unit + .countdown__unit {
    padding-left: clamp(1rem, 3vw, 2.5rem);
    border-left: 1px solid var(--color-border);
  }
  .countdown__live:not([hidden]) {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Countdown",
  "settings": [
    { "type": "paragraph", "content": "The date comes from Theme settings → Daily Bread Club drop." },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        { "value": "large", "label": "Large" },
        { "value": "small", "label": "Small" }
      ],
      "default": "large"
    },
    { "type": "header", "content": "When the drop is live" },
    { "type": "text", "id": "live_text", "label": "Message", "default": "The table is set." },
    { "type": "text", "id": "live_button", "label": "Button label", "default": "Shop the drop" },
    { "type": "url", "id": "live_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Countdown" }]
}
{% endschema %}
