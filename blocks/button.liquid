{% doc %}
  Renders a call-to-action link button.

  @example
  {% content_for 'block', type: 'button', id: 'button' %}
{% enddoc %}

{%- if block.settings.label != blank -%}
  <a class="button {{ block.settings.style }}" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
    {{- block.settings.label -}}
  </a>
{%- endif -%}

{% schema %}
{
  "name": "Button",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Join the club" },
    { "type": "url", "id": "link", "label": "Link" },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "button--primary", "label": "Solid" },
        { "value": "button--secondary", "label": "Outline" }
      ],
      "default": "button--primary"
    }
  ],
  "presets": [{ "name": "Button" }]
}
{% endschema %}
