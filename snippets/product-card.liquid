{% doc %}
  Product card with hover image swap and a locked state for unreleased drops.

  @param {product} product - The product to render
  @param {boolean} [locked] - Hide price and link while the drop is locked
  @param {string} [sizes] - Image sizes attribute

  @example
  {% render 'product-card', product: product %}
{% enddoc %}

{%- liquid
  assign primary = product.featured_media.preview_image
  assign secondary = product.media[1].preview_image
  assign img_sizes = sizes | default: '(min-width: 900px) 25vw, 50vw'
-%}

<article class="product-card{% if locked %} product-card--locked{% endif %} reveal">
  {%- unless locked -%}<a class="product-card__link" href="{{ product.url }}">{%- endunless -%}
    <div class="product-card__media">
      {%- if primary -%}
        {{ primary | image_url: width: 900 | image_tag: loading: 'lazy', sizes: img_sizes, widths: '360, 540, 720, 900', class: 'product-card__img', alt: product.title }}
        {%- if secondary -%}
          {%- unless locked -%}
            {{ secondary | image_url: width: 900 | image_tag: loading: 'lazy', sizes: img_sizes, widths: '360, 540, 720, 900', class: 'product-card__img product-card__img--hover', alt: '' }}
          {%- endunless -%}
        {%- endif -%}
      {%- else -%}
        {{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
      {%- if locked -%}
        <span class="product-card__badge eyebrow">{{ 'products.coming_soon' | t }}</span>
      {%- elsif product.available == false -%}
        <span class="product-card__badge eyebrow">{{ 'products.sold_out' | t }}</span>
      {%- endif -%}
    </div>
    <div class="product-card__info">
      <h3 class="product-card__title">{{ product.title }}</h3>
      {%- if locked -%}
        <p class="muted">{{ 'products.locked' | t }}</p>
      {%- else -%}
        <p class="price">
          {%- if product.price_varies -%}{%- assign min_price = product.price_min | money -%}{{ 'products.from' | t: price: min_price }}{%- else -%}{{ product.price | money }}{%- endif -%}
        </p>
      {%- endif -%}
    </div>
  {%- unless locked -%}</a>{%- endunless -%}
</article>

{% stylesheet %}
  .product-card__link {
    display: block;
    text-decoration: none;
  }
  .product-card__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-surface);
  }
  .product-card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.5s var(--ease), transform 1.2s var(--ease);
  }
  .product-card__img--hover {
    opacity: 0;
  }
  @media (hover: hover) {
    .product-card__link:hover .product-card__img--hover {
      opacity: 1;
    }
    .product-card__link:hover .product-card__img {
      transform: scale(1.03);
    }
  }
  .product-card--locked .product-card__img {
    filter: blur(14px) saturate(0.6);
    transform: scale(1.1);
  }
  .product-card__badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.35rem 0.6rem;
    background: var(--color-background);
    color: var(--color-foreground);
    font-size: 0.625rem;
  }
  .product-card__info {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.75rem;
    font-size: 0.8125rem;
  }
  .product-card__title {
    font-family: var(--font-body--family);
    font-size: inherit;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
  }
{% endstylesheet %}
