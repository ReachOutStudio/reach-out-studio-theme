[
  {
    "name": "theme_info",
    "theme_name": "Reach Out Studio",
    "theme_version": "1.0.0",
    "theme_author": "Reach Out Studio",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "Brand",
    "settings": [
      { "type": "image_picker", "id": "logo", "label": "Logo" },
      { "type": "range", "id": "logo_width", "label": "Logo width", "min": 60, "max": 260, "step": 4, "unit": "px", "default": 132 },
      { "type": "image_picker", "id": "favicon", "label": "Favicon" }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      { "type": "header", "content": "Headings" },
      { "type": "font_picker", "id": "type_heading_font", "label": "Heading font", "default": "oswald_n4" },
      { "type": "range", "id": "heading_letter_spacing", "label": "Heading letter spacing", "min": 0, "max": 20, "step": 1, "unit": "%", "default": 2 },
      { "type": "header", "content": "Body" },
      { "type": "font_picker", "id": "type_body_font", "label": "Body font", "default": "work_sans_n4" },
      { "type": "header", "content": "Story" },
      { "type": "font_picker", "id": "type_story_font", "label": "Story font (serif)", "default": "playfair_display_n4" }
    ]
  },
  {
    "name": "Colours",
    "settings": [
      { "type": "color", "id": "background_color", "label": "Background (bone)", "default": "#F4EFE6" },
      { "type": "color", "id": "surface_color", "label": "Surface", "default": "#EAE3D6" },
      { "type": "color", "id": "foreground_color", "label": "Text (espresso)", "default": "#2B211C" },
      { "type": "color", "id": "accent_color", "label": "Accent (wheat)", "default": "#B8905A" },
      { "type": "color", "id": "inverse_background_color", "label": "Dark background", "default": "#1E1814" },
      { "type": "color", "id": "inverse_foreground_color", "label": "Dark background text", "default": "#F4EFE6" }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "Page width",
        "options": [
          { "value": "90rem", "label": "Narrow" },
          { "value": "120rem", "label": "Wide" }
        ],
        "default": "120rem"
      },
      { "type": "range", "id": "min_page_margin", "min": 10, "max": 60, "step": 1, "unit": "px", "label": "Page margin", "default": 20 },
      { "type": "range", "id": "button_radius", "min": 0, "max": 30, "step": 1, "unit": "px", "label": "Button corner radius", "default": 0 },
      { "type": "range", "id": "input_corner_radius", "min": 0, "max": 10, "step": 1, "unit": "px", "label": "Input corner radius", "default": 0 }
    ]
  },
  {
    "name": "Daily Bread Club drop",
    "settings": [
      { "type": "paragraph", "content": "One date controls every countdown and unlocks the drop products site-wide. Use the format 2026-11-07T10:00:00+00:00." },
      { "type": "text", "id": "drop_datetime", "label": "Drop date and time", "default": "2026-11-07T10:00:00+00:00" },
      { "type": "collection", "id": "drop_collection", "label": "Drop collection" },
      { "type": "text", "id": "waitlist_tag", "label": "Waitlist customer tag", "default": "dbc-waitlist" },
      { "type": "checkbox", "id": "lock_drop_products", "label": "Lock drop products until the drop date", "default": true },
      { "type": "checkbox", "id": "early_access_open", "label": "Early access open for waitlist members", "default": false }
    ]
  }
]
