{% doc %}
  Outputs font faces and global CSS custom properties from theme settings.

  @example
  {% render 'css-variables' %}
{% enddoc %}

{% style %}
  {{ settings.type_heading_font | font_face: font_display: 'swap' }}
  {{ settings.type_body_font | font_face: font_display: 'swap' }}
  {{ settings.type_body_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_story_font | font_face: font_display: 'swap' }}
  {{ settings.type_story_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}

  :root {
    --font-heading--family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    --font-heading--weight: {{ settings.type_heading_font.weight }};
    --font-heading--spacing: {{ settings.heading_letter_spacing | divided_by: 100.0 }}em;
    --font-body--family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    --font-body--weight: {{ settings.type_body_font.weight }};
    --font-story--family: {{ settings.type_story_font.family }}, {{ settings.type_story_font.fallback_families }};
    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;
    --color-background: {{ settings.background_color }};
    --color-surface: {{ settings.surface_color }};
    --color-foreground: {{ settings.foreground_color }};
    --color-foreground-muted: {{ settings.foreground_color | color_modify: 'alpha', 0.62 }};
    --color-border: {{ settings.foreground_color | color_modify: 'alpha', 0.16 }};
    --color-accent: {{ settings.accent_color }};
    --color-inverse-background: {{ settings.inverse_background_color }};
    --color-inverse-foreground: {{ settings.inverse_foreground_color }};
    --radius-button: {{ settings.button_radius }}px;
    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;
    --header-height: 4rem;
    --ease: cubic-bezier(0.2, 0.7, 0.2, 1);
  }
{% endstyle %}
