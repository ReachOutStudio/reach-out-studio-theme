<div class="band {{ section.settings.scheme }} full-width" style="--align: {{ section.settings.alignment }}">
  <div class="band__inner section-pad reveal">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .band__inner {
    display: flex;
    flex-direction: column;
    align-items: var(--align);
    gap: 1.5rem;
    width: min(var(--page-width), 100%);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }
  .band[style*='center'] .band__inner {
    text-align: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Content band",
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "scheme-default", "label": "Bone" },
        { "value": "scheme-surface", "label": "Surface" },
        { "value": "scheme-inverse", "label": "Espresso" }
      ],
      "default": "scheme-inverse"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    }
  ],
  "presets": [
    {
      "name": "Content band",
      "blocks": {
        "eyebrow": { "type": "eyebrow", "settings": { "text": "Members get in first", "alignment": "center" } },
        "heading": { "type": "heading", "settings": { "text": "Save your seat at the <em>table</em>", "size": "h-1", "alignment": "center", "max_width": 16 } },
        "waitlist": { "type": "waitlist", "settings": {} }
      },
      "block_order": ["eyebrow", "heading", "waitlist"]
    }
  ]
}
{% endschema %}
