{%- assign messages = section.blocks | where: 'type', 'message' -%}
{%- if messages.size > 0 -%}
  <div class="announcement full-width scheme-inverse" role="region" aria-label="{{ 'sections.announcement.label' | t }}">
    <div class="announcement__track" style="--count: {{ messages.size }}">
      {%- for block in messages -%}
        <p class="announcement__item eyebrow" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
          {%- else -%}
            {{ block.settings.text }}
          {%- endif -%}
        </p>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .announcement {
    overflow: hidden;
    height: 2.25rem;
  }
  .announcement__track {
    display: grid;
    height: 100%;
  }
  .announcement__item {
    grid-area: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-inline: 1rem;
    text-align: center;
    opacity: 0;
    animation: announcement-cycle calc(var(--count) * 5s) infinite;
  }
  .announcement__item:only-child {
    opacity: 1;
    animation: none;
  }
  .announcement__item:nth-child(2) { animation-delay: 5s; }
  .announcement__item:nth-child(3) { animation-delay: 10s; }
  .announcement__item:nth-child(4) { animation-delay: 15s; }
  .announcement__item a {
    text-decoration: none;
  }
  @keyframes announcement-cycle {
    0%, 30% { opacity: 1; }
    34%, 100% { opacity: 0; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement bar",
  "class": "announcement-section",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Daily Bread Club — join the waitlist" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [{ "type": "message" }]
    }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
