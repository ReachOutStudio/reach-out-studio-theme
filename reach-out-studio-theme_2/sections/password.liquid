<div class="pw full-width">
  <div class="pw__media">
    {%- if section.settings.image -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', sizes: '100vw', widths: '750, 1200, 1800, 2400' }}
    {%- endif -%}
  </div>
  <div class="pw__content">
    <p class="h-3">{{ shop.name }}</p>
    <div class="pw__center">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h1 class="h-display">{{ section.settings.heading }}</h1>
      <drop-countdown class="countdown countdown--large" data-end="{{ settings.drop_datetime | escape }}">
        <div class="countdown__units" data-countdown-units>
          <div class="countdown__unit"><span data-unit="days">00</span><small class="eyebrow">{{ 'sections.countdown.days' | t }}</small></div>
          <div class="countdown__unit"><span data-unit="hours">00</span><small class="eyebrow">{{ 'sections.countdown.hours' | t }}</small></div>
          <div class="countdown__unit"><span data-unit="minutes">00</span><small class="eyebrow">{{ 'sections.countdown.minutes' | t }}</small></div>
          <div class="countdown__unit"><span data-unit="seconds">00</span><small class="eyebrow">{{ 'sections.countdown.seconds' | t }}</small></div>
        </div>
        <div data-countdown-live hidden></div>
      </drop-countdown>
      {%- if shop.password_message != blank -%}
        <p class="story">{{ shop.password_message }}</p>
      {%- endif -%}
      <div class="pw__form">
        {% render 'waitlist-form', form_id: 'PasswordWaitlist', button_label: section.settings.button_label %}
      </div>
    </div>
    <details class="pw__login">
      <summary class="eyebrow">{{ 'password.enter_using' | t }}</summary>
      {%- form 'storefront_password', class: 'pw__password' -%}
        {%- if form.errors -%}
          <p role="alert">{{ form.errors.messages.form }}</p>
        {%- endif -%}
        <label class="visually-hidden" for="PasswordInput">{{ 'password.password' | t }}</label>
        <div class="waitlist-form__row">
          <input class="field" type="password" name="password" id="PasswordInput" autocomplete="current-password" placeholder="{{ 'password.password' | t }}">
          <button type="submit" class="button">{{ 'password.enter' | t }}</button>
        </div>
      {%- endform -%}
    </details>
  </div>
</div>

{% stylesheet %}
  .pw {
    position: relative;
    display: grid;
    min-height: 100svh;
    color: #fff;
    --color-foreground: #fff;
    --color-background: #1e1814;
    --color-border: rgb(255 255 255 / 0.3);
    background: #1e1814;
  }
  .pw__media,
  .pw__content {
    grid-area: 1 / 1;
  }
  .pw__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.55;
  }
  .pw__content {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.5rem var(--page-margin);
  }
  .pw__center {
    display: grid;
    justify-items: center;
    gap: 1.75rem;
    text-align: center;
  }
  .pw__form {
    width: min(28rem, 100%);
  }
  .pw .button {
    background: #fff;
    color: #1e1814;
    border-color: #fff;
  }
  .pw .field::placeholder {
    color: rgb(255 255 255 / 0.7);
  }
  .pw__login {
    align-self: center;
    width: min(24rem, 100%);
    text-align: center;
  }
  .pw__login summary {
    cursor: pointer;
    list-style: none;
  }
  .pw__password {
    margin-top: 1rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Collection 01" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Daily Bread Club" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Save my seat" }
  ]
}
{% endschema %}
