{% doc %}
  Renders rich text in body or story style.

  @example
  {% content_for 'block', type: 'rich-text', id: 'rich-text' %}
{% enddoc %}

<div class="rich-text-block {{ block.settings.style }}" style="--align: {{ block.settings.alignment }}; --max: {{ block.settings.max_width }}ch" {{ block.shopify_attributes }}>
  {{ block.settings.text }}
</div>

{% stylesheet %}
  .rich-text-block {
    text-align: var(--align);
    max-width: var(--max);
  }
  .rich-text-block > * + * {
    margin-top: 1em;
  }
  .rich-text-block[style*='center'] {
    margin-inline: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Text",
  "settings": [
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Some things are meant to be shared. Bread. Mornings. A table with room for one more.</p>" },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "story", "label": "Story (serif)" },
        { "value": "body", "label": "Body" },
        { "value": "muted", "label": "Muted" }
      ],
      "default": "story"
    },
    { "type": "text_alignment", "id": "alignment", "label": "Alignment", "default": "left" },
    { "type": "range", "id": "max_width", "label": "Max width", "min": 20, "max": 80, "step": 2, "unit": "ch", "default": 42 }
  ],
  "presets": [{ "name": "Text" }]
}
{% endschema %}
