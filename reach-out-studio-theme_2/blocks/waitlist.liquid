{% doc %}
  Waitlist sign-up that tags customers for the drop.

  @example
  {% content_for 'block', type: 'waitlist', id: 'waitlist' %}
{% enddoc %}

<div class="waitlist-block" style="--max: {{ block.settings.max_width }}rem" {{ block.shopify_attributes }}>
  {% render 'waitlist-form',
    form_id: block.id,
    button_label: block.settings.button_label,
    success_message: block.settings.success_message,
    show_name: block.settings.show_name
  %}
</div>

{% stylesheet %}
  .waitlist-block {
    width: 100%;
    max-width: var(--max);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Waitlist form",
  "settings": [
    { "type": "paragraph", "content": "Sign-ups are saved as customers with the waitlist tag from Theme settings." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Save my seat" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "You're in. We'll save you a seat at the table." },
    { "type": "checkbox", "id": "show_name", "label": "Ask for first name", "default": false },
    { "type": "range", "id": "max_width", "label": "Max width", "min": 16, "max": 40, "step": 1, "unit": "rem", "default": 28 }
  ],
  "presets": [{ "name": "Waitlist form" }]
}
{% endschema %}
