<div class="iwt iwt--{{ section.settings.image_position }} {{ section.settings.scheme }} full-width">
  <div class="iwt__media reveal" style="--ratio: {{ section.settings.ratio }}">
    {%- if section.settings.image -%}
      {{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 50vw, 100vw', widths: '600, 900, 1200, 1800' }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
    {%- if section.settings.caption != blank -%}
      <p class="iwt__caption eyebrow">{{ section.settings.caption }}</p>
    {%- endif -%}
  </div>
  <div class="iwt__content reveal">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .iwt {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
  }
  .iwt--right .iwt__media {
    order: 2;
  }
  .iwt__media {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background: var(--color-surface);
  }
  .iwt__media img,
  .iwt__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .iwt__caption {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    color: #fff;
    mix-blend-mode: difference;
  }
  .iwt__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    padding: clamp(2.5rem, 7vw, 7rem);
  }
  @media (max-width: 899px) {
    .iwt {
      grid-template-columns: 1fr;
    }
    .iwt--right .iwt__media {
      order: 0;
    }
    .iwt__content {
      padding: 2.5rem var(--page-margin) 3.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Image with story",
  "blocks": [{ "type": "@theme" }],
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "caption", "label": "Image caption", "default": "06:40 — Peckham" },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image shape",
      "options": [
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "3 / 2", "label": "Landscape" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "scheme-default", "label": "Bone" },
        { "value": "scheme-surface", "label": "Surface" },
        { "value": "scheme-inverse", "label": "Espresso" }
      ],
      "default": "scheme-default"
    }
  ],
  "presets": [
    {
      "name": "Image with story",
      "blocks": {
        "eyebrow": { "type": "eyebrow", "settings": { "text": "The ritual" } },
        "heading": { "type": "heading", "settings": { "text": "Before the city <em>wakes</em>", "size": "h-1" } },
        "text": { "type": "rich-text", "settings": {} },
        "button": { "type": "button", "settings": { "label": "Read the story", "style": "button--secondary" } }
      },
      "block_order": ["eyebrow", "heading", "text", "button"]
    }
  ]
}
{% endschema %}
