<div class="faq section-pad {{ section.settings.scheme }} full-width">
  <div class="faq__inner">
    <div class="faq__head reveal">
      <p class="eyebrow muted">{{ section.settings.eyebrow }}</p>
      <h2 class="h-1">{{ section.settings.heading }}</h2>
    </div>
    <div class="faq__list">
      {%- for block in section.blocks -%}
        <details class="faq__item" {{ block.shopify_attributes }}>
          <summary>
            <span class="h-3">{{ block.settings.question }}</span>
            <span class="faq__icon" aria-hidden="true"></span>
          </summary>
          <div class="faq__answer">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .faq__inner {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: clamp(2rem, 6vw, 6rem);
    width: min(var(--page-width), 100%);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }
  .faq__head {
    display: grid;
    align-content: start;
    gap: 1rem;
  }
  .faq__item {
    border-top: 1px solid var(--color-border);
  }
  .faq__item:last-child {
    border-bottom: 1px solid var(--color-border);
  }
  .faq__item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-block: 1.35rem;
    cursor: pointer;
    list-style: none;
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__icon {
    position: relative;
    flex: none;
    width: 0.9rem;
    height: 0.9rem;
  }
  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1.4px;
    background: currentColor;
    transition: transform 0.3s var(--ease);
  }
  .faq__icon::after {
    transform: rotate(90deg);
  }
  .faq__item[open] .faq__icon::after {
    transform: rotate(0deg);
  }
  .faq__answer {
    max-width: 60ch;
    padding-bottom: 1.5rem;
    color: var(--color-foreground-muted);
  }
  .faq__answer > * + * {
    margin-top: 0.75em;
  }
  @media (max-width: 899px) {
    .faq__inner {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Good to know" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions" },
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "scheme-default", "label": "Bone" },
        { "value": "scheme-surface", "label": "Surface" },
        { "value": "scheme-inverse", "label": "Espresso" }
      ],
      "default": "scheme-surface"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "When will my order arrive?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Every piece is made to order.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "FAQ", "blocks": [{ "type": "question" }] }]
}
{% endschema %}
