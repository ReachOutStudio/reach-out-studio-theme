{%- liquid
  assign is_member = false
  if customer and customer.tags contains settings.waitlist_tag
    assign is_member = true
  endif
  assign source = section.settings.collection | default: settings.drop_collection
-%}

<div class="early section-pad">
  {%- if is_member and settings.early_access_open -%}
    <div class="early__head reveal">
      <p class="eyebrow">{{ 'sections.early_access.welcome' | t: name: customer.first_name }}</p>
      <h1 class="h-1">{{ section.settings.member_heading }}</h1>
      <p class="story muted">{{ section.settings.member_text }}</p>
    </div>
    <ul class="featured__grid" role="list" style="--cols: 4">
      {%- for product in source.products limit: 24 -%}
        <li>{% render 'product-card', product: product %}</li>
      {%- else -%}
        <li class="muted">{{ 'sections.early_access.empty' | t }}</li>
      {%- endfor -%}
    </ul>
  {%- else -%}
    <div class="early__gate reveal">
      <p class="eyebrow">{{ 'sections.early_access.members_only' | t }}</p>
      <h1 class="h-1">{{ section.settings.gate_heading }}</h1>
      {%- if customer -%}
        {%- if is_member -%}
          <p class="story">{{ 'sections.early_access.not_yet' | t }}</p>
          <drop-countdown class="countdown countdown--small" data-end="{{ settings.drop_datetime | escape }}">
            <div class="countdown__units" data-countdown-units>
              <div class="countdown__unit"><span data-unit="days">00</span><small class="eyebrow">{{ 'sections.countdown.days' | t }}</small></div>
              <div class="countdown__unit"><span data-unit="hours">00</span><small class="eyebrow">{{ 'sections.countdown.hours' | t }}</small></div>
              <div class="countdown__unit"><span data-unit="minutes">00</span><small class="eyebrow">{{ 'sections.countdown.minutes' | t }}</small></div>
              <div class="countdown__unit"><span data-unit="seconds">00</span><small class="eyebrow">{{ 'sections.countdown.seconds' | t }}</small></div>
            </div>
            <div data-countdown-live hidden></div>
          </drop-countdown>
        {%- else -%}
          <p class="story">{{ 'sections.early_access.not_member' | t }}</p>
          {% render 'waitlist-form', form_id: 'EarlyAccessJoin' %}
        {%- endif -%}
      {%- else -%}
        <p class="story">{{ section.settings.gate_text }}</p>
        <div class="early__actions">
          <a class="button" href="{{ routes.account_login_url }}?return_url={{ request.path | url_encode }}">{{ 'sections.early_access.sign_in' | t }}</a>
        </div>
        <p class="muted">{{ 'sections.early_access.no_account' | t }}</p>
        {% render 'waitlist-form', form_id: 'EarlyAccessWaitlist' %}
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .early__head,
  .early__gate {
    display: grid;
    gap: 1.25rem;
    max-width: 40rem;
    margin-bottom: 3rem;
  }
  .early__gate {
    margin-inline: auto;
    justify-items: center;
    text-align: center;
  }
  .early__gate .countdown__units {
    justify-content: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Early access",
  "settings": [
    { "type": "paragraph", "content": "Customers tagged with the waitlist tag see the drop here once 'Early access open' is ticked in Theme settings." },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to use the drop collection." },
    { "type": "header", "content": "Locked view" },
    { "type": "text", "id": "gate_heading", "label": "Heading", "default": "Members' table" },
    { "type": "textarea", "id": "gate_text", "label": "Text", "default": "Waitlist members shop Daily Bread Club 24 hours before everyone else. Sign in with the email you joined with." },
    { "type": "header", "content": "Member view" },
    { "type": "text", "id": "member_heading", "label": "Heading", "default": "Your seat is ready" },
    { "type": "textarea", "id": "member_text", "label": "Text", "default": "You're early. Take your time — sizes are limited for the first bake." }
  ],
  "presets": [{ "name": "Early access" }]
}
{% endschema %}
