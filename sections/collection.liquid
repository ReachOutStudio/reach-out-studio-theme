<div class="collection-page">
  <header class="collection-page__head">
    <p class="eyebrow muted">{{ 'collections.count' | t: count: collection.products_count }}</p>
    <h1 class="h-display">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="story muted collection-page__desc">{{ collection.description }}</div>
    {%- endif -%}
  </header>

  {%- paginate collection.products by section.settings.per_page -%}
    <div class="collection-page__toolbar">
      {%- if collection.filters.size > 0 -%}
        <details class="filters">
          <summary class="eyebrow">{{ 'collections.filter' | t }}</summary>
          <form class="filters__form" data-filter-form>
            {%- for filter in collection.filters -%}
              {%- if filter.type == 'list' -%}
                <fieldset>
                  <legend class="eyebrow muted">{{ filter.label }}</legend>
                  {%- for value in filter.values -%}
                    <label class="filters__option">
                      <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                      {{ value.label }} <span class="muted">({{ value.count }})</span>
                    </label>
                  {%- endfor -%}
                </fieldset>
              {%- endif -%}
            {%- endfor -%}
            <input type="hidden" name="sort_by" value="{{ collection.sort_by | default: collection.default_sort_by }}">
            <div class="filters__actions">
              <button type="submit" class="button">{{ 'collections.apply' | t }}</button>
              <a class="button button--secondary" href="{{ collection.url }}?sort_by={{ collection.sort_by }}">{{ 'collections.clear' | t }}</a>
            </div>
          </form>
        </details>
      {%- endif -%}

      <form class="sort">
        {%- for filter in collection.filters -%}
          {%- for value in filter.active_values -%}
            <input type="hidden" name="{{ value.param_name }}" value="{{ value.value }}">
          {%- endfor -%}
        {%- endfor -%}
        <label class="eyebrow" for="SortBy">{{ 'collections.sort' | t }}</label>
        <select id="SortBy" name="sort_by" onchange="this.form.submit()">
          {%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}" {% if option.value == current_sort %}selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </div>

    <ul class="featured__grid" role="list" style="--cols: {{ section.settings.columns }}">
      {%- for product in collection.products -%}
        {%- capture is_locked -%}{%- render 'drop-locked', product: product -%}{%- endcapture -%}
        <li>
          {%- if is_locked == 'true' -%}
            {% render 'product-card', product: product, locked: true %}
          {%- else -%}
            {% render 'product-card', product: product %}
          {%- endif -%}
        </li>
      {%- else -%}
        <li class="muted">{{ 'collections.empty' | t }}</li>
      {%- endfor -%}
    </ul>

    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="{{ 'collections.pagination' | t }}">
        {{ paginate | default_pagination: next: '→', previous: '←' }}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% stylesheet %}
  .collection-page {
    padding-block: clamp(2rem, 5vw, 4rem);
  }
  .collection-page__head {
    display: grid;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  .collection-page__desc {
    max-width: 40rem;
  }
  .collection-page__toolbar {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    padding-block: 1rem;
    margin-bottom: 2rem;
    border-block: 1px solid var(--color-border);
  }
  .filters summary {
    cursor: pointer;
  }
  .filters__form {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    padding-top: 1.5rem;
  }
  .filters fieldset {
    display: grid;
    gap: 0.4rem;
    border: 0;
    padding: 0;
  }
  .filters__option {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.875rem;
  }
  .filters__actions {
    display: flex;
    gap: 0.5rem;
    width: 100%;
  }
  .sort {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: auto;
  }
  .sort select {
    border: 0;
    background: transparent;
    font-size: 0.8125rem;
  }
  .pagination {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 3rem;
  }
  .pagination .page,
  .pagination .next,
  .pagination .prev {
    padding: 0.5rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 4, "step": 1, "default": 4 }
  ]
}
{% endschema %}
