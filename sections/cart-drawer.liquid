<dialog id="CartDrawer" class="cart-drawer" aria-labelledby="CartDrawerTitle">
  <div class="cart-drawer__inner" data-cart-drawer-inner data-cart-count="{{ cart.item_count }}">
    <div class="cart-drawer__head">
      <h2 id="CartDrawerTitle" class="h-3">{{ 'cart.title' | t }} ({{ cart.item_count }})</h2>
      <button type="button" class="cart-drawer__close" data-cart-close aria-label="{{ 'accessibility.close' | t }}">
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="m2 2 14 14M16 2 2 16" stroke="currentColor" stroke-width="1.4"/></svg>
      </button>
    </div>

    {%- if cart.item_count > 0 -%}
      {%- if section.settings.free_shipping_threshold > 0 -%}
        {%- liquid
          assign threshold = section.settings.free_shipping_threshold | times: 100
          assign remaining = threshold | minus: cart.total_price
          assign progress = cart.total_price | times: 100 | divided_by: threshold | at_most: 100
        -%}
        <div class="cart-drawer__shipping">
          <p class="eyebrow">
            {%- if remaining > 0 -%}
              {%- assign remaining_money = remaining | money -%}
              {{ 'cart.shipping_remaining' | t: amount: remaining_money }}
            {%- else -%}
              {{ 'cart.shipping_unlocked' | t }}
            {%- endif -%}
          </p>
          <div class="cart-drawer__bar"><span style="width: {{ progress }}%"></span></div>
        </div>
      {%- endif -%}

      <ul class="cart-drawer__items" role="list">
        {%- for item in cart.items -%}
          <li class="cart-item">
            <a class="cart-item__media" href="{{ item.url }}">
              {%- if item.image -%}
                {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.product.title }}
              {%- else -%}
                {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </a>
            <div class="cart-item__info">
              <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}
                <p class="muted">{{ item.variant.title }}</p>
              {%- endunless -%}
              <p class="price">{{ item.final_line_price | money }}</p>
              <div class="qty" role="group" aria-label="{{ 'cart.quantity' | t }}">
                <button type="button" data-line="{{ forloop.index }}" data-cart-qty="{{ item.quantity | minus: 1 }}" aria-label="{{ 'cart.decrease' | t }}">−</button>
                <span>{{ item.quantity }}</span>
                <button type="button" data-line="{{ forloop.index }}" data-cart-qty="{{ item.quantity | plus: 1 }}" aria-label="{{ 'cart.increase' | t }}">+</button>
              </div>
            </div>
            <button type="button" class="cart-item__remove muted" data-line="{{ forloop.index }}" data-cart-qty="0">{{ 'cart.remove' | t }}</button>
          </li>
        {%- endfor -%}
      </ul>

      <div class="cart-drawer__foot">
        <div class="cart-drawer__total">
          <span class="eyebrow">{{ 'cart.subtotal' | t }}</span>
          <span class="price">{{ cart.total_price | money_with_currency }}</span>
        </div>
        <p class="muted">{{ 'cart.taxes_note' | t }}</p>
        <form action="{{ routes.cart_url }}" method="post">
          <button type="submit" name="checkout" class="button button--full">{{ 'cart.checkout' | t }}</button>
        </form>
      </div>
    {%- else -%}
      <div class="cart-drawer__empty">
        <p class="story">{{ 'cart.empty' | t }}</p>
        <a class="button button--secondary" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</dialog>

{% stylesheet %}
  .cart-drawer {
    width: min(28rem, 100vw);
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0 0 0 auto;
    padding: 0;
    border: 0;
  }
  .cart-drawer[open] {
    animation: drawer-in 0.4s var(--ease);
  }
  .cart-drawer::backdrop {
    background: rgb(20 15 12 / 0.45);
  }
  @keyframes drawer-in {
    from { transform: translateX(100%); }
  }
  .cart-drawer__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .cart-drawer__inner[aria-busy='true'] {
    opacity: 0.6;
    pointer-events: none;
  }
  .cart-drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  .cart-drawer__close {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    background: none;
  }
  .cart-drawer__shipping {
    display: grid;
    gap: 0.5rem;
    padding: 1rem 1.5rem;
    background: var(--color-surface);
  }
  .cart-drawer__bar {
    height: 2px;
    background: var(--color-border);
  }
  .cart-drawer__bar span {
    display: block;
    height: 100%;
    background: var(--color-foreground);
  }
  .cart-drawer__items {
    flex: 1;
    overflow-y: auto;
    padding: 0 1.5rem;
    list-style: none;
  }
  .cart-item {
    display: grid;
    grid-template-columns: 5.5rem 1fr auto;
    gap: 1rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }
  .cart-item__media {
    aspect-ratio: 4 / 5;
    background: var(--color-surface);
    overflow: hidden;
  }
  .cart-item__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cart-item__info {
    display: grid;
    align-content: start;
    gap: 0.2rem;
    font-size: 0.875rem;
  }
  .cart-item__title {
    text-decoration: none;
    font-weight: 600;
  }
  .qty {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    margin-top: 0.5rem;
    border: 1px solid var(--color-border);
  }
  .qty button {
    width: 2rem;
    height: 2rem;
    border: 0;
    background: none;
  }
  .qty span {
    min-width: 1.5rem;
    text-align: center;
  }
  .cart-item__remove {
    align-self: start;
    border: 0;
    background: none;
    font-size: 0.75rem;
    text-decoration: underline;
  }
  .cart-drawer__foot {
    display: grid;
    gap: 0.75rem;
    padding: 1.25rem 1.5rem 1.5rem;
    border-top: 1px solid var(--color-border);
  }
  .cart-drawer__foot .muted {
    font-size: 0.75rem;
  }
  .cart-drawer__total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .cart-drawer__empty {
    display: grid;
    place-content: center;
    gap: 1.5rem;
    flex: 1;
    padding: 2rem;
    text-align: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    { "type": "range", "id": "free_shipping_threshold", "label": "Free delivery threshold (£, 0 hides the bar)", "min": 0, "max": 200, "step": 5, "default": 0 }
  ]
}
{% endschema %}
