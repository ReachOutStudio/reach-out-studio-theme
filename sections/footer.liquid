<footer class="site-footer full-width scheme-inverse">
  <div class="site-footer__top">
    <div class="site-footer__signup">
      <p class="eyebrow">{{ section.settings.signup_eyebrow }}</p>
      <h2 class="h-2">{{ section.settings.signup_heading }}</h2>
      {% render 'waitlist-form', form_id: 'FooterSignup', button_label: section.settings.signup_button, tags: 'newsletter' %}
    </div>

    {%- if section.settings.menu != blank -%}
      <nav class="site-footer__col" aria-label="{{ section.settings.menu.title | escape }}">
        <p class="eyebrow muted">{{ section.settings.menu.title }}</p>
        <ul role="list">
          {%- for link in section.settings.menu.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    {%- if section.settings.menu_secondary != blank -%}
      <nav class="site-footer__col" aria-label="{{ section.settings.menu_secondary.title | escape }}">
        <p class="eyebrow muted">{{ section.settings.menu_secondary.title }}</p>
        <ul role="list">
          {%- for link in section.settings.menu_secondary.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    <div class="site-footer__col">
      <p class="eyebrow muted">{{ 'sections.footer.follow' | t }}</p>
      <ul role="list">
        {%- if section.settings.instagram != blank -%}<li><a href="{{ section.settings.instagram }}" rel="noopener" target="_blank">Instagram</a></li>{%- endif -%}
        {%- if section.settings.tiktok != blank -%}<li><a href="{{ section.settings.tiktok }}" rel="noopener" target="_blank">TikTok</a></li>{%- endif -%}
        {%- if section.settings.youtube != blank -%}<li><a href="{{ section.settings.youtube }}" rel="noopener" target="_blank">YouTube</a></li>{%- endif -%}
      </ul>
    </div>
  </div>

  <p class="site-footer__wordmark" aria-hidden="true">{{ section.settings.wordmark | default: shop.name }}</p>

  <div class="site-footer__bottom">
    <p class="muted">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.tagline }}</p>
    {%- if section.settings.show_payment_icons -%}
      <ul class="site-footer__payments" role="list">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</footer>

{% stylesheet %}
  .site-footer {
    padding: clamp(3rem, 7vw, 6rem) var(--page-margin) 1.5rem;
    margin-top: auto;
  }
  .site-footer a {
    text-decoration: none;
  }
  .site-footer a:hover {
    text-decoration: underline;
  }
  .site-footer__top {
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr);
    gap: 3rem;
  }
  .site-footer__signup {
    display: grid;
    gap: 1rem;
    max-width: 28rem;
  }
  .site-footer__col {
    display: grid;
    align-content: start;
    gap: 1rem;
  }
  .site-footer__col ul {
    display: grid;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }
  .site-footer__wordmark {
    margin-block: clamp(3rem, 8vw, 6rem) 1.5rem;
    font-family: var(--font-heading--family);
    font-size: clamp(3rem, 15.5vw, 16rem);
    line-height: 0.8;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    color: var(--color-accent);
  }
  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.75rem;
  }
  .site-footer__payments {
    display: flex;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }
  .site-footer__payments svg {
    height: 1.5rem;
    width: auto;
  }
  @media (max-width: 899px) {
    .site-footer__top {
      grid-template-columns: 1fr 1fr;
    }
    .site-footer__signup {
      grid-column: 1 / -1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "class": "footer-section",
  "settings": [
    { "type": "header", "content": "Sign-up" },
    { "type": "text", "id": "signup_eyebrow", "label": "Eyebrow", "default": "Pull up a chair" },
    { "type": "text", "id": "signup_heading", "label": "Heading", "default": "Join the table" },
    { "type": "text", "id": "signup_button", "label": "Button label", "default": "Join" },
    { "type": "header", "content": "Menus" },
    { "type": "link_list", "id": "menu", "label": "Menu one", "default": "footer" },
    { "type": "link_list", "id": "menu_secondary", "label": "Menu two" },
    { "type": "header", "content": "Social" },
    { "type": "url", "id": "instagram", "label": "Instagram" },
    { "type": "url", "id": "tiktok", "label": "TikTok" },
    { "type": "url", "id": "youtube", "label": "YouTube" },
    { "type": "header", "content": "Bottom" },
    { "type": "text", "id": "wordmark", "label": "Large wordmark", "default": "Reach Out" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Made in London." },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
