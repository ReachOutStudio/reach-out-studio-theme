<header class="site-header full-width{% if section.settings.transparent_on_home and template.name == 'index' %} site-header--overlay{% endif %}" data-header>
  <div class="site-header__inner">
    <details class="site-header__mobile">
      <summary class="site-header__icon" aria-label="{{ 'sections.header.menu' | t }}">
        <span class="burger" aria-hidden="true"><span></span><span></span></span>
      </summary>
      <nav class="mobile-nav" aria-label="{{ 'sections.header.menu' | t }}">
        <ul role="list">
          {%- for link in section.settings.menu.links -%}
            <li><a class="h-2" href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </nav>
    </details>

    <nav class="site-header__nav" aria-label="{{ 'sections.header.primary' | t }}">
      <ul role="list">
        {%- for link in section.settings.menu.links -%}
          <li>
            <a class="eyebrow{% if link.active %} is-active{% endif %}" href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <a class="site-header__logo" href="{{ routes.root_url }}">
      {%- if settings.logo -%}
        {{ settings.logo | image_url: width: 520 | image_tag: alt: shop.name, loading: 'eager', class: 'site-header__logo-img' }}
      {%- else -%}
        <span class="h-3">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <div class="site-header__icons">
      <a class="site-header__icon" href="{{ routes.search_url }}" aria-label="{{ 'sections.header.search' | t }}">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="8.5" cy="8.5" r="6" stroke="currentColor" stroke-width="1.4"/><path d="m13 13 5 5" stroke="currentColor" stroke-width="1.4"/></svg>
      </a>
      {%- if shop.customer_accounts_enabled -%}
        <a class="site-header__icon site-header__account" href="{{ routes.account_url }}" aria-label="{{ 'sections.header.account' | t }}">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="10" cy="6.5" r="3.8" stroke="currentColor" stroke-width="1.4"/><path d="M2.5 18.5c.8-4 3.8-6 7.5-6s6.7 2 7.5 6" stroke="currentColor" stroke-width="1.4"/></svg>
        </a>
      {%- endif -%}
      <a class="site-header__icon site-header__cart" href="{{ routes.cart_url }}" data-cart-open aria-label="{{ 'sections.header.cart' | t }}">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 6.5h14l-1 11.5H4L3 6.5Z" stroke="currentColor" stroke-width="1.4"/><path d="M7 8.5V5a3 3 0 0 1 6 0v3.5" stroke="currentColor" stroke-width="1.4"/></svg>
        <span class="cart-count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

<style>
  #shopify-section-{{ section.id }} { --logo-width: {{ settings.logo_width }}px; }
</style>

{% stylesheet %}
  .header-section {
    position: sticky;
    top: 0;
    z-index: 20;
  }
  .site-header {
    background: var(--color-background);
    border-bottom: 1px solid var(--color-border);
    transition: background-color 0.3s var(--ease), color 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  .site-header--overlay {
    background: transparent;
    border-color: transparent;
    color: #fff;
  }
  .template-index main > .shopify-section:first-child .hero--overlap {
    margin-top: calc(var(--header-height) * -1);
  }
  .site-header__logo-img {
    width: var(--logo-width);
    height: auto;
  }
  .site-header--overlay.is-scrolled,
  .site-header--overlay:has(details[open]) {
    background: var(--color-background);
    border-color: var(--color-border);
    color: var(--color-foreground);
  }
  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--header-height);
    padding-inline: var(--page-margin);
  }
  .site-header__nav ul {
    display: flex;
    gap: 1.75rem;
    padding: 0;
    list-style: none;
  }
  .site-header__nav a {
    text-decoration: none;
    padding-block: 0.25rem;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 0.3s var(--ease);
  }
  .site-header__nav a:hover,
  .site-header__nav a.is-active {
    background-size: 100% 1px;
  }
  .site-header__logo {
    justify-self: center;
    text-decoration: none;
  }
  .site-header--overlay:not(.is-scrolled):not(:has(details[open])) .site-header__logo img {
    filter: brightness(0) invert(1);
  }
  .site-header__icons {
    display: flex;
    justify-content: flex-end;
    gap: 0.25rem;
  }
  .site-header__icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    text-decoration: none;
    cursor: pointer;
    list-style: none;
  }
  .site-header__icon::-webkit-details-marker {
    display: none;
  }
  .cart-count {
    position: absolute;
    top: 0.2rem;
    right: 0.1rem;
    min-width: 1.05rem;
    height: 1.05rem;
    padding-inline: 0.2rem;
    border-radius: 1rem;
    background: var(--color-accent);
    color: #fff;
    font-size: 0.625rem;
    line-height: 1.05rem;
    text-align: center;
  }
  .site-header__mobile {
    display: none;
  }
  .burger {
    display: grid;
    gap: 5px;
    width: 20px;
  }
  .burger span {
    display: block;
    height: 1.4px;
    background: currentColor;
    transition: transform 0.3s var(--ease);
  }
  details[open] .burger span:first-child {
    transform: translateY(3.2px) rotate(45deg);
  }
  details[open] .burger span:last-child {
    transform: translateY(-3.2px) rotate(-45deg);
  }
  .mobile-nav {
    position: fixed;
    inset: var(--header-height) 0 0;
    padding: 2rem var(--page-margin);
    background: var(--color-background);
    color: var(--color-foreground);
    overflow-y: auto;
  }
  .mobile-nav ul {
    display: grid;
    gap: 1rem;
    padding: 0;
    list-style: none;
  }
  .mobile-nav a {
    text-decoration: none;
  }
  @media (max-width: 899px) {
    .site-header__nav,
    .site-header__account {
      display: none;
    }
    .site-header__mobile {
      display: block;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const update = () => {
      document.querySelectorAll('[data-header]').forEach((header) => {
        header.classList.toggle('is-scrolled', window.scrollY > 40);
      });
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Header",
  "class": "header-section",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "checkbox", "id": "transparent_on_home", "label": "Transparent over the homepage hero", "default": true }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
