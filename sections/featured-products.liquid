{%- liquid
  assign source = section.settings.collection | default: settings.drop_collection
  assign columns = section.settings.columns
-%}

<div class="featured section-pad">
  <div class="featured__head reveal">
    <div>
      <p class="eyebrow muted">{{ section.settings.eyebrow }}</p>
      <h2 class="h-1">{{ section.settings.heading | default: source.title }}</h2>
    </div>
    {%- if source != blank and section.settings.show_link -%}
      <a class="button button--secondary" href="{{ source.url }}">{{ 'sections.featured.view_all' | t }}</a>
    {%- endif -%}
  </div>

  <ul class="featured__grid" role="list" style="--cols: {{ columns }}">
    {%- if source != blank and source.products_count > 0 -%}
      {%- for product in source.products limit: section.settings.limit -%}
        {%- capture is_locked -%}{%- render 'drop-locked', product: product -%}{%- endcapture -%}
        <li>
          {%- if is_locked == 'true' -%}
            {% render 'product-card', product: product, locked: true %}
          {%- else -%}
            {% render 'product-card', product: product %}
          {%- endif -%}
        </li>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..columns) -%}
        <li>
          <div class="product-card">
            <div class="product-card__media">{{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
            <div class="product-card__info"><h3 class="product-card__title">{{ 'products.placeholder' | t }}</h3><p class="muted">£—</p></div>
          </div>
        </li>
      {%- endfor -%}
    {%- endif -%}
  </ul>
</div>

{% stylesheet %}
  .featured__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .featured__head > div {
    display: grid;
    gap: 1rem;
  }
  .featured__grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    gap: 2.5rem 1rem;
    padding: 0;
    list-style: none;
  }
  @media (max-width: 899px) {
    .featured__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem 0.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The first bake" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Daily Bread Club" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to use the drop collection." },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 4, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_link", "label": "Show 'view all' button", "default": true }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
